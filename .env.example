# Public site origin used for canonical URLs, sitemap and Open Graph.
SITE_URL=https://www.example.com
PORT=5173
# Production enquiry endpoint (API, CRM webhook or form backend). Build-time variable.
VITE_ENQUIRY_ENDPOINT=
# Set to "true" to expose /demo in production (prefer the --demo flag on a private deployment).
ENABLE_DEMO=false
